#function to reload table after configuration file change
def reload():
    subprocess.run(["sudo", "nft", "-f", "nftables.conf"])

#function to add to mariadb database
def add_to_db(table, value, index, transmission_type=None, connection_type=None):
    query = f"INSERT INTO {table} ({index}) VALUES (%s)"
    data = (value,)
    cursor.execute(query, data)
    conn.commit()

#funciton to remove from mariadb database
def remove_from_db(table, value, index):
    query = f"DELETE FROM {table} WHERE {index} = %s"
    cursor.execute(query, (value,))
    conn.commit()

#function to check for additional requirements
def check_additional_requirements():
    connection_type = input("tcp or udp: ")
    if (connection_type != "tcp") and (connection_type != "udp"):
        print("must be valid connection type")
        return
    transmission_type = input("source or destination: ")
    if (transmission_type != "source") and (transmission_type != "destination"):
        print("must be a valid transmission type")
        return
    elif transmission_type == "source":
        transmission_value = "sport"
    elif transmission_type == "destination":
        transmission_value = "dport"
    return connection_type,transmission_value

#function to add port
def add_port():
    port_number = int(input("Port Number: "))
    if port_number in accepted_ports:
        print("port already accepted")
        return
    if port_number in blocked_ports:
        remove_from_db("blocked_ports", port_number, "port")
    connection_type,transmission_value = check_additional_requirements()
    string_arg = f'/# END: ACCEPTED INSIDE PORT CONNECTION/i \\\t{connection_type} {transmission_value} {port_number} accept'
    subprocess.run(["sudo", "sed", "-i",
        string_arg, "nftables.conf"])
    add_to_db("accepted_ports", port_number, "port")

#function to remove port
def remove_port():
    port_number = input("Port Number: ")
    if port_number in blocked_ports:
        print("port already blocked")
        return
    if port_number in accepted_ports:
        remove_from_db("accepted_ports", port_number, "port")
    connection_type,transmission_value = check_additional_requirements()
    string_arg = f'/# END: DENIED INSIDE PORT CONNECTIONS/i \\\t{connection_type} {transmission_value} {port_number} deny'
    subprocess.run(["sudo", "sed", "-i",
        string_arg, "nftables.conf"])
    add_to_db("blocked_ports", port_number, "port", transmission_type, connection_type)

#function to add ip address
def add_ip():
    ip_address = input("ip address: ")
    if ip_address in whitelist:
        print("ip address is already accepted")
        return
    if ip_address in blacklist:
        remove_from_db("blacklist", ip_address, "ip")
    if (is_valid_ip(ip_address) == False):
        print("must be a valid ip address")
        return
    connection_type,transmission_value = check_additional_requirements()
    string_arg = f'/# END: ACCEPTED INSIDE IP CONNECTIONS/i \\\t{connection_type} {transmission_value} {ip_address} accept'
    subprocess.run(["sudo", "sed", "-i",
        string_arg, "nftables.conf"])
    add_to_db("whitelist", ip_address, "ip")

#function to add remove ip_address
def remove_ip():
    ip_address = input("ip address: ")
    if ip_address in blacklist:
        print("ip address is already blocked")
        return
    if ip_address in whitelist:
        remove_from_db("whitelist", ip_address, "ip")
    if (is_valid_ip(ip_address) == False):
        print("must be a valid ip address")
        return
    connection_type,transmission_value = check_additional_requirements()
    string_arg = f'/# END: ACCEPTED INSIDE IP CONNECTIONS/i \\\t{connection_type} {transmission_value} {ip_address} deny'
    subprocess.run(["sudo", "sed", "-i",
        string_arg, "nftables.conf"])
    add_to_db("blacklist", ip_address, "ip")

#function to add remove users
def add_user():
    user = input("name of user: ")
    if user in allowed_users:
        print("user is already on the whitelist")
        return
    if user in blocked_users:
        remove_from_db("blocked_users", user, "name")
    add_to_db("allowed_users", user, "name")

#function to remove users
def remove_user():
