        functions = ["0. allow port through network", "1. blocked port",
                    "2. allow service to run on network", "3. block service",
                    "4. add ip to whitelist", "5. add ip to blacklist",
                    "6. allow new user on network", "7. block user on network"]

        for i in functions:
            print(i)
        
        choice = int(input("Choose function (enter number): "))

        functions = [add_port, remove_port,
